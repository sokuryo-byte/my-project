@echo off
rem Familia Home Service - monthly app desktop shortcut installer
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$u='https://script.google.com/a/macros/monthly-familia.com/s/AKfycbwTYZlYhsaXyKlNEq_95lhvwuOK2x2l1aPUncFYq071WtYdxGOmBpQHZa_TqUlUR7z4/exec';$d=Join-Path $env:LOCALAPPDATA 'FamiliaMonthly'; New-Item -ItemType Directory -Force -Path $d | Out-Null;$ico=Join-Path $d 'icon.ico';[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;Invoke-WebRequest -UseBasicParsing -Uri 'https://cdn.jsdelivr.net/gh/sokuryo-byte/my-project@1fbe64a16947958362597c0fbdc410c35690da18/assets/icon.ico' -OutFile $ico;$n=-join([char[]]@(0x30DE,0x30F3,0x30B9,0x30EA,0x30FC,0x7269,0x4EF6,0x767B,0x9332));$c=$null; foreach($k in 'HKCU:','HKLM:'){ $p=(Get-ItemProperty ($k+'\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\chrome.exe') -ErrorAction SilentlyContinue).'(default)'; if($p -and (Test-Path $p)){ $c=$p; break } };$s=(New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path ([Environment]::GetFolderPath('Desktop')) ($n+'.lnk')));if($c){ $s.TargetPath=$c; $s.Arguments='--app='+$u } else { $s.TargetPath=(Join-Path $env:WINDIR 'explorer.exe'); $s.Arguments=$u };$s.IconLocation=$ico+',0'; $s.Save();Write-Host (-join([char[]]@(0x30C7,0x30B9,0x30AF,0x30C8,0x30C3,0x30D7,0x306B,0x300C,0x30DE,0x30F3,0x30B9,0x30EA,0x30FC,0x7269,0x4EF6,0x767B,0x9332,0x300D,0x3092,0x4F5C,0x308A,0x307E,0x3057,0x305F,0x3002)))"
if errorlevel 1 (echo Failed. Please send a screenshot.) else (echo OK)
pause
